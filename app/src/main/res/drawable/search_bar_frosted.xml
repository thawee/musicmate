<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base translucent surface -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" /> <!-- ~10% white -->
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Refraction sheen -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#20FFFFFF"
                android:endColor="#00000000"
                android:angle="90" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Glass edge stroke -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
        </shape>
    </item>

</layer-list>
