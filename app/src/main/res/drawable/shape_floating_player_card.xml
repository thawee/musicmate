<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Rich dark slate surface base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F21E222A" />
            <corners android:radius="32dp"/>
        </shape>
    </item>

    <!-- Subtle accent top sheen -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#33FFFFFF"
                android:endColor="#05FFFFFF"
                android:angle="270" />
            <corners android:radius="32dp"/>
        </shape>
    </item>

    <!-- Vibrant gold accent border for active media playback -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp"/>
            <stroke android:width="1.5dp" android:color="#66FFD700" />
        </shape>
    </item>
</layer-list>
