<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Heavy base dark surface to reduce visual noise (92% opacity) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EB0A0A0A" /> 
            <corners android:radius="24dp"/>
        </shape>
    </item>

    <!-- Subtle glass sheen gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#14FFFFFF"
                android:endColor="#00000000"
                android:angle="90" />
            <corners android:radius="24dp"/>
        </shape>
    </item>

    <!-- 1px Subtle Inner Stroke (Highlight at the very top edge) -->
    <item android:bottom="1dp" android:left="-2dp" android:right="-2dp" android:top="-2dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp"/>
            <solid android:color="#00000000" />
        </shape>
    </item>

    <!-- Wait, Android layer-list for top border only is tricky. 
         A simple full border with 0.08 opacity works nicely. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp"/>
            <stroke android:width="1dp" android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
