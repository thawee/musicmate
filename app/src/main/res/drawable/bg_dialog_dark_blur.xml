<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base dark surface for depth -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D9121212" /> <!-- 85% dark base -->
            <corners android:radius="24dp"/>
        </shape>
    </item>

    <!-- Glass sheen gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#26FFFFFF"
                android:endColor="#00000000"
                android:angle="90" />
            <corners android:radius="24dp"/>
        </shape>
    </item>

    <!-- Sharp glass edge stroke -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp"/>
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
        </shape>
    </item>
</layer-list>
