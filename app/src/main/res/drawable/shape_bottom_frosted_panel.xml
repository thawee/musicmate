<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep obsidian dark surface -->
    <item>
        <shape android:shape="rectangle">
            <!-- Almost pure black for maximum contrast and OLED benefit -->
            <solid android:color="#F2050505" />
        </shape>
    </item>

    <!-- Subtle top glass sheen/border -->
    <item android:bottom="-2dp" android:left="-2dp" android:right="-2dp" android:top="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
        </shape>
    </item>
</layer-list>
