<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep obsidian dark surface -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F212151C" />
            <corners android:radius="16dp"/>
        </shape>
    </item>

    <!-- Subtle top glass sheen -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#25FFFFFF"
                android:endColor="#00000000"
                android:angle="270" />
            <corners android:radius="16dp"/>
        </shape>
    </item>

    <!-- Distinct cyan/teal accent border line -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <stroke android:width="1.5dp" android:color="#4480CBC4" />
        </shape>
    </item>
</layer-list>
