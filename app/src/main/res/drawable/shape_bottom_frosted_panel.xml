<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base dark surface for depth -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#80000000" /> <!-- 50% dark base for contrast -->
            <corners android:radius="32dp"/>
        </shape>
    </item>

    <!-- Milky glass fill to stand out from background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" /> <!-- 10% white frosted tint -->
            <corners android:radius="32dp"/>
        </shape>
    </item>

    <!-- Glass sheen gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#33FFFFFF"
                android:endColor="#00000000"
                android:angle="90" />
            <corners android:radius="32dp"/>
        </shape>
    </item>

    <!-- Sharp glass edge stroke -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp"/>
            <stroke android:width="1.5dp" android:color="#4DFFFFFF" />

        </shape>
    </item>
</layer-list>
