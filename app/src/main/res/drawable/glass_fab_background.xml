<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base translucent surface -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1A121212" /> <!-- 10% dark base -->
        </shape>
    </item>

    <!-- Glass sheen gradient -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#20FFFFFF"
                android:endColor="#00000000"
                android:angle="90" />
        </shape>
    </item>

    <!-- Glass edge stroke -->
    <item>
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
        </shape>
    </item>
</layer-list>
