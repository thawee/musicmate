<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark top-down scrim for high text readability on light covers -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#CC0A0A0A"
                android:centerColor="#660A0A0A"
                android:endColor="#00000000"
                android:angle="270" />
        </shape>
    </item>

    <!-- Subtle bottom glass edge divider -->
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <solid android:color="#26FFFFFF" />
        </shape>
    </item>
</layer-list>
