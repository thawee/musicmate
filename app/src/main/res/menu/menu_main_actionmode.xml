<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press multi-select action mode menu.
     Focused on batch tag management and file operations — no playback clutter. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Primary: tag management — the app's core job -->
    <item
        android:id="@+id/action_edit_metadata"
        android:icon="@drawable/ic_baseline_edit_note_24"
        android:title="Edit Tags"
        app:showAsAction="always" />

    <!-- File operations -->
    <item
        android:id="@+id/action_transfer_file"
        android:icon="@drawable/rounded_drive_file_move_24"
        android:title="Move Files"
        app:showAsAction="always" />

    <item
        android:id="@+id/action_encoding_file"
        android:icon="@drawable/rounded_swap_horiz_24"
        android:title="Convert Files"
        app:showAsAction="always" />

    <item
        android:id="@+id/action_delete"
        android:icon="@drawable/rounded_delete_24"
        android:title="@string/action_delete"
        app:showAsAction="always" />

    <!-- Selection utility -->
    <item
        android:id="@+id/action_select_all"
        android:icon="@drawable/rounded_select_all_24"
        android:title="@string/action_select_all"
        app:showAsAction="always" />

</menu>