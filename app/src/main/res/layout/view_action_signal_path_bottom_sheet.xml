<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_dark_blur"
    android:elevation="8dp"
    android:clipToOutline="true"
    android:outlineProvider="background"
    android:layout_margin="12dp"
    tools:ignore="UseCompoundDrawables">

    <!-- Signal Path Title and Lossless Indicator -->
    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_dialog_header_gradient"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <ImageView
            android:id="@+id/title_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_musicmate_logo"
            android:layout_marginEnd="12dp"
            app:tint="#FFD700" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Signal Mastery"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"/>

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/quality_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Local Path"
            android:textColor="#FFD700"
            android:textStyle="bold"
            android:textSize="14sp" />

    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/dimen_12_dp">

    <!-- Signal Path Container -->
    <LinearLayout
        android:id="@+id/signal_path_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    </LinearLayout>
    <View
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dimen_2_dp"
        android:background="@color/grays_charcoal"
        android:layout_marginStart="@dimen/dimen_24_dp"
        android:layout_marginEnd="@dimen/dimen_24_dp"
        android:layout_marginBottom="@dimen/dimen_8_dp"/>
</LinearLayout>