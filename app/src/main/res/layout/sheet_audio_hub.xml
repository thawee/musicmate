<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_dark_blur"
    android:paddingTop="10dp"
    android:paddingBottom="12dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:background="@drawable/shape_dot_indicator"
        android:backgroundTint="#55FFFFFF" />

    <!-- Unified Master Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/audio_hub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Now Playing"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 3 Page Indicator Dots -->
        <LinearLayout
            android:id="@+id/audio_hub_dots_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <View
                android:id="@+id/dot_now_playing"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/shape_circle_green"
                android:backgroundTint="@color/colorGold" />

            <View
                android:id="@+id/dot_signal_path"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/shape_circle_green"
                android:backgroundTint="#55FFFFFF" />

            <View
                android:id="@+id/dot_media_server"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/shape_circle_green"
                android:backgroundTint="#55FFFFFF" />
        </LinearLayout>

        <!-- Header Action Icons -->
        <ImageView
            android:id="@+id/btn_select_target_player"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/rounded_music_cast_24"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Select Player"
            app:tint="?attr/colorOnSurface" />

        <ImageView
            android:id="@+id/btn_close_audio_hub"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/round_close_24"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>

    <!-- Top Swappable ViewPager2 (Now Playing Card / Signal Path / Media Server) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/audio_hub_view_pager"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginHorizontal="12dp" />

    <!-- FIXED BOTTOM SECTION: Queue Controls & List (Visible on ALL Pages) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp">

        <!-- Queue Toolbar: Title & Count / Clear -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/sheet_queue_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/btn_clear_queue"
                android:layout_centerVertical="true"
                android:text="Queue"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_clear_queue"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="5dp"
                android:src="@drawable/rounded_delete_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/colorMuted" />
        </RelativeLayout>

        <!-- Empty Queue Message -->
        <TextView
            android:id="@+id/sheet_empty_queue_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:gravity="center"
            android:text="Playback queue is empty"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Queue RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sheet_queue_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="true"
            android:scrollbars="vertical" />
    </LinearLayout>

</LinearLayout>
