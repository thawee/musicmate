<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginVertical="0dp"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:strokeWidth="0dp"
    app:strokeColor="@android:color/transparent"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/selector_item_background"
        android:duplicateParentState="true"
        android:minHeight="88dp"
        android:padding="8dp">

        <!-- Album Art -->
        <FrameLayout
            android:id="@+id/item_imageFrame"
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/item_image_coverart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.RoundedImageView" />

            <!-- Play overlay: only visible when track is currently playing -->
            <FrameLayout
                android:id="@+id/item_play_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/shape_now_playing_cover_overlay"
                android:visibility="gone"
                android:clickable="false"
                android:focusable="false">

                <ImageView
                    android:id="@+id/item_play_overlay_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_equalizer_active"
                    android:scaleType="centerInside"
                    app:tint="@color/colorGold"
                    android:contentDescription="@string/cd_now_playing_indicator" />
            </FrameLayout>

            <ImageView
                android:id="@+id/item_new_label"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_new_sparkle_badge"
                android:visibility="gone"
                android:contentDescription="@string/cd_new_label" />
        </FrameLayout>


        <!-- Title + Subtitle -->
        <LinearLayout
            android:id="@+id/item_title_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            app:layout_constraintStart_toEndOf="@id/item_imageFrame"
            app:layout_constraintEnd_toStartOf="@id/item_indicators"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/item_metadata_row">

            <TextView
                android:id="@+id/item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                android:fontFamily="@font/noto_sans_thai_bold"
                android:textColor="?attr/colorOnSurface"
                tools:text="Song Title" />

            <TextView
                android:id="@+id/item_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:fontFamily="@font/noto_sans_thai_semi_bold"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Artist Name" />
        </LinearLayout>

        <!-- Metadata Row -->
        <LinearLayout
            android:id="@+id/item_metadata_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toEndOf="@id/item_imageFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/item_title_layout">

            <apincer.android.mmate.ui.view.BadgeView
                android:id="@+id/icon_codec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <apincer.android.mmate.ui.view.QualityIndicatorView
                android:id="@+id/icon_quality_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"/>

            <apincer.android.mmate.ui.view.BadgeView
                android:id="@+id/icon_resolution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"/>
            
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <apincer.android.mmate.ui.view.DynamicRangeView
                android:id="@+id/dynamic_range_db_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                app:dr="DR12"/>

            <apincer.android.mmate.ui.view.BadgeView
                android:id="@+id/view_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"/>
        </LinearLayout>

        <!-- Status Indicators (Top Right) -->
        <LinearLayout
            android:id="@+id/item_indicators"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toStartOf="@id/item_more_menu"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginEnd="4dp">

            <!--
            <apincer.android.mmate.ui.view.RatingIndicatorView
                android:id="@+id/rating_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:mode="icon" />
                -->
        </LinearLayout>

        <apincer.android.mmate.ui.view.RatingIndicatorView
            android:id="@+id/rating_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingRight="@dimen/dimen_8_dp"
            android:contentDescription="Favalite"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:mode="icon" />

        <ImageView
            android:id="@+id/item_more_menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:contentDescription="More options"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:src="@drawable/rounded_more_vert_24" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
