<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:strokeWidth="1dp"
    app:strokeColor="#1AFFFFFF"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/selector_item_background"
        android:duplicateParentState="true"
        android:minHeight="88dp"
        android:padding="8dp">

        <!-- Album Art -->
        <FrameLayout
            android:id="@+id/item_imageFrame"
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/item_image_coverart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.RoundedImageView" />

            <apincer.android.mmate.ui.view.TriangleLabelView
                android:id="@+id/item_new_label"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="top|end"
                app:backgroundColor="#FFD700"
                app:corner="rightTop"
                app:primaryText="New"
                app:primaryTextColor="#000000"
                app:primaryTextSize="8sp" />
        </FrameLayout>

        <!-- Title + Subtitle -->
        <LinearLayout
            android:id="@+id/item_title_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            app:layout_constraintStart_toEndOf="@id/item_imageFrame"
            app:layout_constraintEnd_toStartOf="@id/item_indicators"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/item_metadata_row">

            <TextView
                android:id="@+id/item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                android:fontFamily="@font/noto_sans_thai_bold"
                android:textColor="?attr/colorOnSurface"
                tools:text="Song Title" />

            <TextView
                android:id="@+id/item_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:fontFamily="@font/noto_sans_thai_semi_bold"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Artist Name" />
        </LinearLayout>

        <!-- Metadata Row -->
        <LinearLayout
            android:id="@+id/item_metadata_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toEndOf="@id/item_imageFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/item_title_layout">

            <apincer.android.mmate.ui.view.BadgeView
                android:id="@+id/icon_codec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <apincer.android.mmate.ui.view.QualityIndicatorView
                android:id="@+id/icon_quality_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"/>

            <apincer.android.mmate.ui.view.BadgeView
                android:id="@+id/icon_resolution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"/>
            
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <apincer.android.mmate.ui.view.DynamicRangeView
                android:id="@+id/dynamic_range_db_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                app:dr="DR12"/>

            <apincer.android.mmate.ui.view.BadgeView
                android:id="@+id/view_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"/>
        </LinearLayout>

        <!-- Status Indicators (Top Right) -->
        <LinearLayout
            android:id="@+id/item_indicators"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <apincer.android.mmate.ui.view.RatingIndicatorView
                android:id="@+id/rating_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:mode="icon" />

            <ImageView
                android:id="@+id/item_player"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/shape_round_background_playing"
                android:padding="4dp"
                android:scaleType="fitXY"
                android:src="@drawable/ic_notification_default"
                app:tint="#FFD700"
                tools:ignore="ContentDescription" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
