<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="6dp">

    <!-- Queue Toolbar: Title & Count / Duration / Clear -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/btn_clear_queue"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sheet_queue_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upcoming Queue"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sheet_queue_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="0 tracks"
                android:textColor="@color/colorMuted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_jump_to_now_playing"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:padding="6dp"
                android:src="@drawable/ic_center_focus_strong_black_24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Jump to Now Playing"
                app:tint="@color/colorGold" />

            <ImageView
                android:id="@+id/btn_clear_queue"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/rounded_delete_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Clear Queue"
                app:tint="@color/colorMuted" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Empty Queue Message -->
    <TextView
        android:id="@+id/sheet_empty_queue_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:text="Playback queue is empty"
        android:textColor="@color/grey400"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Queue RecyclerView (Full Height) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sheet_queue_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="true"
        android:scrollbars="vertical" />

</LinearLayout>
