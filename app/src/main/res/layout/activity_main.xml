<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.MainActivity">

    <!-- 🌌 Dynamic Blurred Background -->
    <ImageView
        android:id="@+id/main_background_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.4"
        android:contentDescription="@string/cd_background_blur" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 🔷 Persistent Header -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_background_main_header"
            android:paddingHorizontal="@dimen/dimen_12_dp"
            android:paddingTop="@dimen/dimen_8_dp"
            android:paddingBottom="@dimen/dimen_6_dp"
            android:elevation="1dp"
            android:alpha="1.0">

            <ImageView
                android:id="@+id/header_back_btn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_baseline_arrow_back_24"
                android:contentDescription="@string/back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/dimen_4_dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/search_view"
                app:layout_constraintTop_toTopOf="@id/search_view" />

            <androidx.appcompat.widget.SearchView
                android:id="@+id/search_view"
                android:layout_width="0dp"
                android:layout_height="@dimen/dimen_40_dp"
                android:layout_marginStart="@dimen/dimen_8_dp"
                android:layout_marginEnd="@dimen/dimen_8_dp"
                android:background="@drawable/search_bar_frosted"
                android:queryHint="@string/search_music_hint"
                app:iconifiedByDefault="false"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/header_back_btn"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/header_stats_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="@dimen/dimen_4_dp"
                app:layout_constraintTop_toBottomOf="@id/search_view"
                app:layout_constraintStart_toStartOf="@id/header_back_btn"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:text="622 songs · 44 hrs 24 min" />

            <LinearLayout
                android:id="@+id/scan_progress_dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:visibility="gone"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginTop="@dimen/dimen_4_dp"
                app:layout_constraintTop_toBottomOf="@id/search_view"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <View
                    android:id="@+id/scan_dot1"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/shape_dot_indicator" />

                <View
                    android:id="@+id/scan_dot2"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/shape_dot_indicator" />

                <View
                    android:id="@+id/scan_dot3"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/shape_dot_indicator" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 🔹 Content List -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">


                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <androidx.compose.ui.platform.ComposeView
                        android:id="@+id/compose_list_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>

            

            <FrameLayout
                android:id="@+id/empty_state_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- 🌟 Secondary glow behind the icon -->
                <View
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_gravity="center"
                    android:background="@drawable/shape_empty_state_glow"
                    android:alpha="0.8" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/ic_musicmate_logo"
                        android:alpha="0.9"
                        app:tint="?attr/colorOnSurface"
                        android:contentDescription="@string/cd_musicmate_logo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/empty_library_title"
                        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                        android:gravity="center"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/empty_library_subtitle"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>


    <!-- 🔹 Floating Glass Dock (Unified Navigation & Playback) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_navigation_container"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="6dp"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:strokeWidth="1.5dp"
        app:strokeColor="#26FFFFFF">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shape_bottom_frosted_panel"
            android:paddingHorizontal="12dp"
            android:gravity="center_vertical">

            <!-- Left: Mini Album Art (Tapping opens Music Center / Now Playing) -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/bar_album_art"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_now_playing_idle"
                android:contentDescription="Now Playing"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.RoundedImageView" />

            <!-- Mini-Player Progress Bar -->
            <ProgressBar
                android:id="@+id/dock_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="0dp"
                android:progressTint="#FFFFD700" android:progressBackgroundTint="#33FFFFFF"
                android:visibility="gone"
                tools:visibility="visible"
                tools:progress="45" />

            <!-- Center: Docked Playback Bar / App Title -->
            <LinearLayout
                android:id="@+id/docked_playback_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toEndOf="@id/bar_album_art"
                android:layout_toStartOf="@id/navigation_collections"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Track Info / Default Title -->
                <LinearLayout
                    android:id="@+id/bar_title_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:id="@+id/bar_track_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:text="@string/app_name" />

                    <TextView
                        android:id="@+id/bar_target_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:visibility="gone"
                        tools:visibility="visible"
                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="HiBy R3 • DLNA Renderer" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_dock_play_pause"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_baseline_play_arrow_24"
                    android:contentDescription="@string/play"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="?attr/colorOnSurface" />

                <ImageView
                    android:id="@+id/btn_dock_next"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_baseline_skip_next_24"
                    android:contentDescription="Next"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- Right: Library Collections / MusicMate Menu Button -->
            <ImageView
                android:id="@+id/navigation_collections"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_nav_musicmate_menu"
                android:contentDescription="MusicMate Menu"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:elevation="4dp"
                app:tint="?attr/colorOnSurface" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>