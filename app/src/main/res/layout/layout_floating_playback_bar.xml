<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/floating_playback_bar"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_gravity="bottom"
    android:layout_marginHorizontal="0dp"
    android:layout_marginBottom="0dp"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone"
    tools:visibility="visible"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shape_bottom_frosted_panel"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <!-- Album Art -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/bar_album_art"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_musicmate_logo"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.RoundedImageView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Track & Target Titles -->
        <LinearLayout
            android:id="@+id/bar_title_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@id/bar_album_art"
            app:layout_constraintEnd_toStartOf="@id/bar_controls_container"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/bar_track_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="?attr/colorOnSurface"
                tools:text="Awaiting Audio Selection" />

            <TextView
                android:id="@+id/bar_target_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="HiBy R3 • DLNA Renderer" />
        </LinearLayout>

        <!-- Transport Control Buttons -->
        <LinearLayout
            android:id="@+id/bar_controls_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/bar_btn_previous"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_baseline_skip_previous_24"
                android:contentDescription="Previous"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorOnSurface" />

            <ImageView
                android:id="@+id/bar_btn_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="6dp"
                android:src="@drawable/ic_baseline_play_arrow_24"
                android:contentDescription="@string/play"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorOnSurface" />

            <ImageView
                android:id="@+id/bar_btn_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_baseline_skip_next_24"
                android:contentDescription="Next"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
