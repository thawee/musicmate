<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_dark_blur"
    android:elevation="24dp"
    android:outlineSpotShadowColor="@color/black"
    android:outlineAmbientShadowColor="@color/black"
    android:clipToOutline="true"
    android:outlineProvider="background"
    android:padding="12dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/shape_dot_indicator"
        android:backgroundTint="#55FFFFFF"/>

    <!-- ── PINNED TOP SECTION: Header ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_header_gradient"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/rounded_music_note_24"
            app:tint="@color/colorGold"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Now Playing"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"/>

        <ImageView
            android:id="@+id/btn_select_target_player"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/rounded_music_cast_24"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Select Player"
            app:tint="@color/white"/>

        <ImageView
            android:id="@+id/btn_media_server"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/rounded_broadcast_on_personal_24"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/media_server"
            app:tint="@color/colorMuted"/>

        <ImageView
            android:id="@+id/btn_open_signal_path"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_baseline_audio_path_24"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Audio Route Path"
            app:tint="@color/colorGold"/>

        <ImageView
            android:id="@+id/btn_close_queue_sheet"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_round_keyboard_arrow_down_24"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            app:tint="@color/white"/>
    </LinearLayout>

    <!-- ── PINNED NOW PLAYING CARD (Cover Art, Info & Transport Buttons) ── -->
    <LinearLayout
        android:id="@+id/sheet_now_playing_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:padding="8dp"
        android:orientation="vertical"
        android:gravity="top"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <!-- Top Row: Cover Art + Track Info + Verdict Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Large album art with gesture feedback overlay -->
            <FrameLayout
                android:id="@+id/sheet_album_art_container"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:clickable="true"
                android:focusable="true">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/sheet_album_art"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_musicmate_logo"
                    android:contentDescription="Album artwork"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.RoundedImageView"/>

                <!-- Dark Glassmorphic Technical Specs Overlay (Flips in on Tap) -->
                <LinearLayout
                    android:id="@+id/sheet_tech_specs_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/shape_specs_card"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AUDIO ANATOMY"
                        android:textColor="@color/colorGold"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/sheet_specs_format"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/white"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/sheet_specs_bitrate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/grey300"
                        android:textSize="9.5sp"
                        android:gravity="center"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/sheet_specs_dr"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#FFA000"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/sheet_specs_file_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/grey400"
                        android:textSize="9sp"
                        android:gravity="center"
                        android:maxLines="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Tap to flip"
                        android:textColor="@color/colorMuted"
                        android:textSize="8sp" />
                </LinearLayout>

                <!-- Gesture Play/Pause/Skip Feedback Overlay Icon -->
                <ImageView
                    android:id="@+id/sheet_gesture_feedback_icon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_baseline_play_arrow_48"
                    android:background="@drawable/shape_now_playing_cover_overlay"
                    android:padding="8dp"
                    android:visibility="gone"
                    android:alpha="0"
                    app:tint="@color/colorGold"
                    android:contentDescription="Playback gesture action" />

                <!-- Flip / Info Hint Button Badge in top-right corner -->
                <ImageView
                    android:id="@+id/sheet_btn_flip_specs"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="4dp"
                    android:background="@drawable/shape_telemetry_chip_source"
                    android:padding="4dp"
                    android:src="@drawable/ic_round_info_24"
                    app:tint="@color/colorGold"
                    android:contentDescription="Flip Audio Specs" />
            </FrameLayout>

            <!-- Track info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sheet_track_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="@color/white"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/sheet_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/grey400"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/sheet_signal_verdict"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/colorGold"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Telemetry Chips Row: Source | DR | Bit-Perfect | Target -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Telemetry Source Badge -->
                    <LinearLayout
                        android:id="@+id/sheet_node_source_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/shape_telemetry_chip_source"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="2dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_round_audio_file_24"
                            app:tint="@color/colorGold"
                            android:contentDescription="Audio Source" />
                        <TextView
                            android:id="@+id/sheet_node_source_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:textColor="@color/colorGold"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <!-- Dynamic Range (DR) Badge (Visible when DR score > 0) -->
                    <!--
                    <LinearLayout
                        android:id="@+id/sheet_node_dr_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/shape_telemetry_chip_dr"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="2dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">
                        <TextView
                            android:id="@+id/sheet_node_dr_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFA000"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:maxLines="1" />
                    </LinearLayout>
                    -->

                    <!-- Bit-Perfect / Direct Badge (Visible when bit-perfect) -->
                    <LinearLayout
                        android:id="@+id/sheet_node_bitperfect_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/shape_telemetry_chip_bitperfect"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="2dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DIRECT"
                            android:textColor="#00E676"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:maxLines="1" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Telemetry Target Badge -->
                <LinearLayout
                    android:id="@+id/sheet_node_target_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/shape_telemetry_chip_target"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/sheet_node_target_icon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_round_speaker_24"
                        app:tint="#00E5FF"
                        android:contentDescription="Output Player Target" />
                    <TextView
                        android:id="@+id/sheet_node_target_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:textColor="#00E5FF"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- FULL-WIDTH Consolidated Audiophile Signal Path Widget (1 Line per Node) -->
        <LinearLayout
            android:id="@+id/sheet_signal_path_widget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <!-- Live Signal Path Chain: 1-Line Full Width Flow -->
            <LinearLayout
                android:id="@+id/sheet_signal_path_chain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Node 1: Source (Single 1-Line Chip) -->
                <!--
                <LinearLayout
                    android:id="@+id/sheet_node_source_box"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/shape_node_source"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="5dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/sheet_node_source_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:gravity="center"
                        android:ellipsize="end" />
                </LinearLayout>
                -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/shape_node_connector"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="2dp"
                    android:text="➔"
                    android:textColor="@color/colorGold"
                    android:textSize="11sp" />

                <!-- Node 2: Transport (Single 1-Line Chip) -->
                <LinearLayout
                    android:id="@+id/sheet_node_engine_box"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.1"
                    android:background="@drawable/shape_node_transport"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="5dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/sheet_node_engine_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:gravity="center"
                        android:ellipsize="end" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:background="@drawable/shape_node_connector"
                    android:paddingHorizontal="3dp"
                    android:paddingVertical="2dp"
                    android:text="➔"
                    android:textColor="@color/colorGold"
                    android:textSize="11sp" />

                <!-- Node 3: Target Output (Single 1-Line Chip) -->
                <!--
                <LinearLayout
                    android:id="@+id/sheet_node_target_box"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.1"
                    android:background="@drawable/shape_node_target"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="5dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <TextView
                        android:id="@+id/sheet_node_target_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/colorGold"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:gravity="center"
                        android:ellipsize="end" />
                </LinearLayout>
                -->
            </LinearLayout>
        </LinearLayout>

                <!-- Quick Actions row: [Favorite] [Edit Tags] [More Actions] -->
                <!--
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/btn_sheet_favorite"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:padding="3dp"
                        android:src="@drawable/round_favorite_border_24"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Favorite"
                        app:tint="@color/grey400" />

                    <ImageView
                        android:id="@+id/btn_sheet_edit_tags"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="12dp"
                        android:padding="3dp"
                        android:src="@drawable/ic_round_edit_24"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Edit Metadata"
                        app:tint="@color/grey400" />

                    <ImageView
                        android:id="@+id/btn_sheet_more_actions"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="12dp"
                        android:padding="3dp"
                        android:src="@drawable/rounded_more_vert_24"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="More Actions"
                </LinearLayout>
                -->

        <!-- Interactive Seekbar & Time labels -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <SeekBar
                android:id="@+id/sheet_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                android:progressDrawable="@drawable/custom_seekbar_progress"
                android:splitTrack="false"
                android:minHeight="12dp"
                android:maxHeight="12dp"
                android:thumbTint="@color/colorGold" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:paddingHorizontal="4dp">

                <TextView
                    android:id="@+id/sheet_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:fontFeatureSettings="tnum"
                    android:text="00:00"
                    android:textColor="@color/grey400"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/sheet_total_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFeatureSettings="tnum"
                    android:text="00:00"
                    android:textColor="@color/grey400"
                    android:textSize="12sp" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Transport controls row: [Shuffle] [Prev] [Play/Pause] [Next] [Repeat] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Shuffle toggle button -->
            <ImageView
                android:id="@+id/btn_toggle_shuffle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/ic_baseline_shuffle_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Shuffle"
                app:tint="@color/grey400" />

            <ImageView
                android:id="@+id/sheet_btn_previous"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:padding="10dp"
                android:src="@drawable/ic_skip_previous_rounded"
                android:contentDescription="Previous"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/sheet_btn_play_pause"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="12dp"
                android:padding="10dp"
                android:src="@drawable/ic_play_rounded"
                android:contentDescription="Play"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/sheet_btn_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:padding="10dp"
                android:src="@drawable/ic_skip_next_rounded"
                android:contentDescription="Next"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white" />

            <!-- Repeat mode toggle button -->
            <ImageView
                android:id="@+id/btn_toggle_repeat"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/ic_baseline_repeat_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Repeat Mode"
                app:tint="@color/grey400" />
        </LinearLayout>

        <!-- Volume control row -->
        <LinearLayout
            android:id="@+id/sheet_volume_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp">

            <ImageView
                android:id="@+id/btn_sheet_volume_down"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/ic_baseline_volume_down_24"
                android:contentDescription="Volume Down"
                app:tint="@color/grey400" />

            <SeekBar
                android:id="@+id/sheet_volume_seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:progressTint="@color/grey400"
                android:thumbTint="@color/white" />

            <ImageView
                android:id="@+id/btn_sheet_volume_up"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/ic_baseline_volume_up_24"
                android:contentDescription="Volume Up"
                app:tint="@color/grey400" />
        </LinearLayout>

        <!-- Expandable Signal Path Telemetry Container -->
        <LinearLayout
            android:id="@+id/sheet_signal_path_expandable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@drawable/bg_rounded_surface_dark"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Audio Signal Telemetry"
                android:textColor="@color/colorGold"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/sheet_signal_path_steps_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── PINNED QUEUE HEADER ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/rounded_order_play_24"
            app:tint="@color/grey400"/>

        <TextView
            android:id="@+id/sheet_queue_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Queue"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="@color/white"/>



        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clear_queue"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="0dp"
            android:padding="8dp"
            android:text="Clear"
            android:textSize="14sp"
            app:icon="@drawable/rounded_delete_24"
            app:iconSize="14dp"
            app:iconGravity="textStart"/>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#22FFFFFF"
        android:layout_marginBottom="6dp"/>

    <!-- ── SCROLLABLE QUEUE LIST SECTION ── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="180dp">

        <TextView
            android:id="@+id/sheet_empty_queue_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:gravity="center"
            android:text="Queue is empty"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/grey400"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sheet_queue_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="vertical"
            android:overScrollMode="always"/>
    </FrameLayout>

</LinearLayout>
