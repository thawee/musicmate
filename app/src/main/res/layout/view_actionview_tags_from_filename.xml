<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_dark_blur"
    android:elevation="8dp"
    android:clipToOutline="true"
    android:outlineProvider="background"
    android:layout_margin="12dp"
    tools:ignore="UseCompoundDrawables">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_dialog_header_gradient"
        android:padding="@dimen/dimen_14_dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_file_rename_outline_24"
            android:layout_marginEnd="8dp"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Read TAGs from filename"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/full_filename"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_8_dp"
        android:layout_marginTop="@dimen/dimen_8_dp"
        android:layout_marginEnd="@dimen/dimen_8_dp"
        android:background="@drawable/shape_background_filename"
        android:gravity="start"
        android:maxLines="3"
        android:padding="@dimen/dimen_4_dp"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingEnd="@dimen/spacing_medium"
        android:textColor="@color/grey200"
        android:fontFamily="@font/sfthonburi_regular"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textSize="11sp"
        tools:text="directory/track - title" />

    <!-- Auto-detect and Presets -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dimen_4_dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_auto_detect"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_detect_pattern"
            android:textSize="12sp"
            app:cornerRadius="16dp"
            app:icon="@drawable/round_auto_awesome_24"
            app:iconSize="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/or"
            android:textColor="@color/grey500"
            android:layout_marginHorizontal="8dp"
            android:textSize="12sp"/>

        <Spinner
            android:id="@+id/spinner_presets"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/shape_round_format_black"
            android:padding="8dp"
            android:textColor="@color/white"
            android:textSize="12sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dimen_4_dp"
        android:background="@drawable/border_back_label"
        android:orientation="vertical"
        android:padding="@dimen/dimen_4_dp">

        <co.lujun.androidtagview.TagContainerLayout
            android:id="@+id/tagcontainerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="0dp"
            android:padding="4dp"
            android:background="@drawable/shape_round_format_black"
            app:container_background_color="@color/grey400"
            app:container_border_color="?attr/colorOutline"
            app:container_border_radius="0dp"
            app:container_enable_drag="true"
            app:container_gravity="left"
            app:horizontal_interval="10dp"
            app:tag_background_color="?attr/colorSurface"
            app:tag_border_color="?attr/colorPrimary"
            app:tag_border_width="1dp"
            app:tag_clickable="true"
            app:tag_corner_radius="6dp"
            app:tag_enable_cross="true"
            app:tag_horizontal_padding="10dp"
            app:tag_max_length="18"
            app:tag_text_color="?attr/colorOnSurface"
            app:tag_theme="none"
            app:vertical_interval="10dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dimen_36_dp"
            android:layout_marginTop="@dimen/dimen_6_dp"
            android:background="@drawable/shape_round_format_black"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/btn_add_sep"
                android:layout_width="@dimen/dimen_36_dp"
                android:layout_height="@dimen/dimen_32_dp"
                android:layout_centerVertical="true"
                android:background="@drawable/shape_border_grey"
                android:gravity="center"
                android:padding="@dimen/dimen_2_dp"
                android:text="/"
                android:textColor="@color/grey300" />

            <TextView
                android:id="@+id/btn_add_dash"
                android:layout_width="@dimen/dimen_36_dp"
                android:layout_height="@dimen/dimen_32_dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dimen_6_dp"
                android:layout_toEndOf="@+id/btn_add_sep"
                android:background="@drawable/shape_border_grey"
                android:gravity="center"
                android:padding="@dimen/dimen_2_dp"
                android:text="-"
                android:textColor="@color/grey300" />

            <TextView
                android:id="@+id/btn_add_dot"
                android:layout_width="@dimen/dimen_36_dp"
                android:layout_height="@dimen/dimen_32_dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dimen_6_dp"
                android:layout_toEndOf="@+id/btn_add_dash"
                android:background="@drawable/shape_border_grey"
                android:gravity="center"
                android:padding="@dimen/dimen_2_dp"
                android:text="."
                android:textColor="@color/grey300" />

            <TextView
                android:id="@+id/btn_add_space"
                android:layout_width="@dimen/dimen_48_dp"
                android:layout_height="@dimen/dimen_32_dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dimen_6_dp"
                android:layout_toEndOf="@+id/btn_add_dot"
                android:background="@drawable/shape_border_grey"
                android:gravity="center"
                android:padding="@dimen/dimen_2_dp"
                android:text="sp"
                android:textColor="@color/grey300" />

            <TextView
                android:id="@+id/btn_add_free_text"
                android:layout_width="@dimen/dimen_36_dp"
                android:layout_height="@dimen/dimen_32_dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dimen_6_dp"
                android:layout_toEndOf="@+id/btn_add_space"
                android:background="@drawable/shape_border_grey"
                android:gravity="center"
                android:padding="@dimen/dimen_2_dp"
                android:text=" ? "
                android:textColor="@color/grey300" />

            <FrameLayout
                android:id="@+id/btn_preview_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/shape_border_back">

                <TextView
                    android:id="@+id/btn_preview"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:gravity="center"
                    android:paddingStart="@dimen/dimen_8_dp"
                    android:paddingEnd="@dimen/dimen_8_dp"
                    android:text="Preview"
                    android:textColor="@color/white" />
            </FrameLayout>
        </RelativeLayout>
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/editorCardview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="10dp"
        app:cardElevation="@dimen/spacing_xsmall"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:id="@+id/editorPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_medium"
                android:layout_marginTop="@dimen/spacing_medium"
                android:layout_marginEnd="@dimen/spacing_medium"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/title_label"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dimen_24_dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/shape_border_grey"
                    android:paddingStart="@dimen/dimen_8_dp"
                    android:paddingEnd="@dimen/dimen_8_dp"
                    android:text="@string/editor_label_title" />

                <EditText
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:gravity="start"
                    android:hint="@string/editor_label_title"
                    android:imeOptions="actionNext"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_medium"
                android:layout_marginTop="@dimen/spacing_medium"
                android:layout_marginEnd="@dimen/spacing_medium"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/artist_label"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dimen_24_dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/shape_border_grey"
                    android:paddingStart="@dimen/dimen_8_dp"
                    android:paddingEnd="@dimen/dimen_8_dp"
                    android:text="@string/editor_label_artist" />

                <EditText
                    android:id="@+id/artist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:gravity="start"
                    android:hint="@string/editor_label_artist"
                    android:imeOptions="actionNext"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_medium"
                android:layout_marginTop="@dimen/spacing_medium"
                android:layout_marginEnd="@dimen/spacing_medium"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/album_label"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dimen_24_dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/shape_border_grey"
                    android:paddingStart="@dimen/dimen_8_dp"
                    android:paddingEnd="@dimen/dimen_8_dp"
                    android:text="@string/editor_label_album" />

                <EditText
                    android:id="@+id/album"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:gravity="start"
                    android:hint="@string/editor_label_album"
                    android:imeOptions="actionNext"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_medium"
                android:layout_marginTop="@dimen/spacing_medium"
                android:layout_marginEnd="@dimen/spacing_medium"
                android:layout_marginBottom="@dimen/spacing_large"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/track_label"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dimen_24_dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/shape_border_grey"
                    android:paddingStart="@dimen/dimen_8_dp"
                    android:paddingEnd="@dimen/dimen_8_dp"
                    android:text="@string/editor_label_track" />

                <EditText
                    android:id="@+id/track"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:gravity="start"
                    android:imeOptions="actionNext"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/dimen_16_dp"
        android:layout_marginBottom="@dimen/dimen_12_dp"
        android:layout_marginEnd="@dimen/dimen_8_dp"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/cancel"/>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="?attr/colorOutline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_ok"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_marginStart="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save"/>
    </LinearLayout>
</LinearLayout>