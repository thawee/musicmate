<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:orientation="vertical"
    android:background="#FF181A1D"
    tools:context=".ui.TagsActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <!-- 🌌 Dynamic Blurred Background -->
    <ImageView
        android:id="@+id/main_background_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.4"
        tools:ignore="ContentDescription" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/toolbar_layout"
            app:contentScrim="@android:color/transparent"
            app:statusBarScrim="@android:color/transparent"
            app:titleEnabled="false"
            app:scrimVisibleHeightTrigger="100dp"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <FrameLayout
                android:id="@+id/frame_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/shape_background_main_header"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/panel_cover_art_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_collapseMode="parallax"
                android:background="@color/transparent">

                <RelativeLayout
                    android:id="@+id/cover_art_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constrainedHeight="true">

                    <FrameLayout
                        android:id="@+id/cover_art_frame"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <apincer.android.mmate.ui.view.AspectRatioPhotoView
                            android:id="@+id/panel_cover_art"
                            android:layout_width="240dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|center_horizontal"
                            android:layout_marginTop="16dp"
                            android:scaleType="fitCenter"
                            app:heightRatio="1"
                            app:widthRatio="1"/>

                        <!-- Back affordance -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_back"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="top|start"
                            android:layout_marginTop="16dp"
                            android:layout_marginStart="16dp"
                            android:padding="0dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:contentDescription="@string/btn_back_cd"
                            app:backgroundTint="#E61C1C1E"
                            app:strokeColor="#FF747478"
                            app:strokeWidth="0dp"
                            app:cornerRadius="24dp"
                            app:icon="@drawable/ic_baseline_arrow_back_24"
                            app:iconTint="@android:color/white"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="24dp" />

                        <!-- 🎨 Frosted Cover Art Edit Badge -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_change_cover_art"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="16dp"
                            android:layout_marginEnd="16dp"
                            android:padding="0dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:contentDescription="@string/btn_edit_cover"
                            app:backgroundTint="#E61C1C1E"
                            app:strokeColor="#FF747478"
                            app:strokeWidth="0dp"
                            app:cornerRadius="24dp"
                            app:icon="@drawable/ic_baseline_add_photo_alternate_24"
                            app:iconTint="@android:color/white"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="24dp" />

                        <!-- Play this song; long-press plays it next. Sits inside the 240dp
                             cover's bottom-right corner: 120 - 28 (half button) - 8 = 84dp. -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_play_song"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:translationX="84dp"
                            android:translationY="-8dp"
                            android:padding="0dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:contentDescription="@string/btn_play_song_cd"
                            app:backgroundTint="#FFFFD700"
                            app:cornerRadius="28dp"
                            app:icon="@drawable/ic_baseline_play_arrow_32"
                            app:iconTint="#FF121212"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="32dp" />

                    </FrameLayout>

                    <!-- Title shares the preview surface below the full square cover. -->
                    <LinearLayout
                        android:id="@+id/title_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/cover_art_frame"
                        android:background="#FF181A1D"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:id="@+id/panel_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/sample_song_title"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:fontFamily="@font/noto_sans_thai_bold"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:textSize="18sp" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- Badges sit directly under the cover to eliminate the dead zone -->
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/tags_header_badges"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="#FF181A1D"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="16dp"
                    app:layout_constraintTop_toBottomOf="@id/cover_art_container"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/tags_tab_pill_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_bottom_frosted_panel"/>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewpager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:layout_marginBottom="0dp" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/preview_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF181A1D"
        android:visibility="gone" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- 🔹 Floating Action Dock (Accessible 2-Row Bottom Command Bar) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_navigation_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="24dp"
        app:cardBackgroundColor="#FF22262B"
        app:strokeWidth="1dp"
        app:strokeColor="#26FFFFFF">

        <LinearLayout
            android:id="@+id/bottom_navigation_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp"
            android:background="@android:color/transparent">

            <!-- Row 1: Understated console utilities with hairline separators -->
            <LinearLayout
                android:id="@+id/main_menu_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <!-- Delete lives in More… (last, in red): beside Organize it was one mis-tap away -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_organize"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/button_organize"
                    android:textColor="#FFBCC5CF"
                    android:textSize="13sp"
                    android:letterSpacing="0.02"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/rounded_drive_file_move_24"
                    app:iconTint="#FFBCC5CF"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="20dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="#16FFFFFF"
                    android:importantForAccessibility="no" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_more"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/button_more"
                    android:textColor="#FFBCC5CF"
                    android:textSize="13sp"
                    android:letterSpacing="0.02"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/rounded_more_vert_24"
                    app:iconGravity="textStart"
                    app:iconTint="#FFBCC5CF"
                    app:iconPadding="6dp"
                    app:iconSize="20dp" />
            </LinearLayout>

            <!-- Row 2: Context Dependent Actions -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <!-- 1. Preview Mode Actions (65/35 split) -->
                <LinearLayout
                    android:id="@+id/preview_action_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/action_editor"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:layout_weight="65"
                        android:minWidth="0dp"
                        android:paddingHorizontal="12dp"
                        android:text="@string/button_edit_song_info"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:contentDescription="Open editor"
                        app:backgroundTint="#FF2A2F35"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_round_edit_24"
                        app:iconGravity="textStart"
                        app:iconTint="#FF90CAF9"
                        app:iconPadding="8dp"
                        app:iconSize="20dp" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:layout_weight="35"
                        android:layout_marginStart="10dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/action_preview_save"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="52dp"
                            android:minWidth="0dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="30dp"
                            android:text="@string/btn_save"
                            android:textColor="#FF1A1D21"
                            android:textSize="15sp"
                            android:contentDescription="Save changes"
                            app:backgroundTint="#FF2A2F35"
                            app:cornerRadius="14dp"
                            app:icon="@drawable/ic_round_save_24"
                            app:iconGravity="textStart"
                            app:iconTint="#FFBCC5CF"
                            app:iconPadding="6dp"
                            app:iconSize="20dp" />

                        <View
                            android:id="@+id/save_state_indicator"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/shape_dock_indicator"
                            android:importantForAccessibility="no" />

                        <ProgressBar
                            android:id="@+id/save_progress_indicator"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="8dp"
                            android:indeterminateTint="#FF1A1D21"
                            android:importantForAccessibility="no"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <!-- 2. Editor Mode Actions (Song Info Fragment) -->
                <LinearLayout
                    android:id="@+id/editor_action_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/action_reformat"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="10dp"
                        android:layout_marginHorizontal="4dp"
                        android:text="@string/btn_format"
                        android:contentDescription="Format tags"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/round_auto_awesome_24"
                        app:iconPadding="4dp"
                        app:iconSize="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/action_read_tag"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="10dp"
                        android:layout_marginHorizontal="4dp"
                        android:text="@string/btn_read"
                        android:contentDescription="Read tags from file"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_file_rename_outline_24"
                        app:iconPadding="4dp"
                        app:iconSize="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/action_save"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="14dp"
                        android:layout_marginHorizontal="4dp"
                        android:text="@string/btn_save"
                        android:contentDescription="Save changes"
                        android:textColor="@color/colorPrimary"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_round_save_24"
                        app:iconTint="@color/colorPrimary"
                        app:iconPadding="4dp"
                        app:iconSize="18dp" />
                </LinearLayout>

                <!-- 3. Tech Info Mode Actions (Tech Info Fragment) -->
                <LinearLayout
                    android:id="@+id/tech_action_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_reload_tag"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="10dp"
                        android:layout_marginHorizontal="4dp"
                        android:text="@string/btn_reload"
                        android:contentDescription="Reload tags from file"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_extract_coverart"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="10dp"
                        android:layout_marginHorizontal="4dp"
                        android:text="@string/btn_extract_art"
                        android:contentDescription="Save cover art to folder"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_remove_coverart"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="10dp"
                        android:layout_marginHorizontal="4dp"
                        android:text="@string/btn_remove_art"
                        android:contentDescription="Remove embedded cover art"
                        android:textColor="#FFFF6E6E"
                        app:cornerRadius="18dp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
