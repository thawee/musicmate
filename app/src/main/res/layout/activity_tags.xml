<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.TagsActivity">

    <!-- 🌌 Dynamic Blurred Background -->
    <ImageView
        android:id="@+id/main_background_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.4"
        tools:ignore="ContentDescription" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/toolbar_layout"
            app:contentScrim="@android:color/transparent"
            app:statusBarScrim="@android:color/transparent"
            app:titleEnabled="false"
            app:scrimVisibleHeightTrigger="100dp"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <FrameLayout
                android:id="@+id/frame_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/shape_background_main_header"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/panel_cover_art_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_collapseMode="parallax"
                android:background="@color/transparent">
                
                <RelativeLayout
                    android:id="@+id/cover_art_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constrainedHeight="true">
                    
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <apincer.android.mmate.ui.view.AspectRatioPhotoView
                            android:id="@+id/panel_cover_art"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scaleType="fitCenter"
                            app:heightRatio="1"
                            app:widthRatio="1"/>

                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/title_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:background="@drawable/shape_background_main_header"
                        android:orientation="vertical"
                        android:paddingTop="42dp"
                        android:paddingBottom="16dp">

                        <TextView
                            android:id="@+id/panel_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/sample_song_title"
                            android:maxLines="2"
                            android:lines="2"
                            android:gravity="center"
                            android:layout_gravity="top|center_horizontal"
                            android:fontFamily="@font/noto_sans_thai_bold"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:layout_marginStart="24dp"
                            android:layout_marginEnd="24dp" />
                    </LinearLayout>
                </RelativeLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="@dimen/dimen_32_dp"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <include layout="@layout/fragment_editor_preview" />
                
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/tags_header_badges"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:padding="8dp" />
            </LinearLayout>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_bottom_frosted_panel"
            app:tabIndicatorColor="?attr/colorPrimary"
            app:tabSelectedTextColor="?attr/colorPrimary"
            app:tabTextColor="#80FFFFFF"
            app:tabTextAppearance="@style/TextAppearance.Material3.TitleSmall"/>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewpager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="160dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>

    <!-- 🔹 Floating Action Capsule (Streamlined 1-Row Bottom Command Bar) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_navigation_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="0dp"
        android:layout_marginBottom="0dp"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:strokeWidth="0dp">

        <LinearLayout
            android:id="@+id/bottom_navigation_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingHorizontal="10dp"
            android:paddingBottom="8dp"
            android:background="@drawable/shape_bottom_frosted_panel">

            <!-- Left: Delete Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_delete"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="@string/button_delete"
                android:textColor="@color/colorError" />

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_marginHorizontal="4dp"
                android:background="@color/colorDividerSubtle" />

            <!-- Center Mode Actions Container -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <!-- 1. Preview Mode Center Actions -->
                <LinearLayout
                    android:id="@+id/preview_action_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_organize"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="@string/button_organize"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/action_editor"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/button_edit_song_info"
                        android:textColor="@color/colorPrimary"
                        android:contentDescription="Open editor"
                        app:cornerRadius="20dp"/>
                </LinearLayout>

                <!-- 2. Editor Mode Center Actions -->
                <LinearLayout
                    android:id="@+id/editor_action_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/action_reformat"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:contentDescription="Format tags"
                        app:icon="@drawable/round_auto_awesome_24" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="20dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@color/colorDividerSubtle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/action_read_tag"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:contentDescription="Read tags from file"
                        app:icon="@drawable/ic_file_rename_outline_24" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="20dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@color/colorDividerSubtle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/action_save"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="12dp"
                        android:contentDescription="Save changes"
                        android:textColor="@color/colorPrimary"
                        app:cornerRadius="20dp"
                        app:icon="@drawable/ic_round_save_24"
                        app:iconTint="@color/colorPrimary" />
                </LinearLayout>

                <!-- 3. Tech Info Mode Center Actions -->
                <LinearLayout
                    android:id="@+id/tech_action_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_reload_tag"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:contentDescription="Reload from file"
                        app:icon="@drawable/round_restore_page_24" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="20dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@color/colorDividerSubtle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_extract_coverart"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:contentDescription="Extract cover art"
                        app:icon="@drawable/ic_round_image_24" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="20dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@color/colorDividerSubtle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_remove_coverart"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:contentDescription="Remove cover art"
                        app:icon="@drawable/ic_round_hide_image_24" />
                </LinearLayout>
            </FrameLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_marginHorizontal="4dp"
                android:background="@color/colorDividerSubtle" />

            <!-- Right: More Actions Menu Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_more"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="@string/button_more"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>