<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.TagsActivity">

    <!-- 🌌 Dynamic Blurred Background -->
    <ImageView
        android:id="@+id/main_background_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.4"
        tools:ignore="ContentDescription" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/toolbar_layout"
            app:contentScrim="@android:color/transparent"
            app:statusBarScrim="@android:color/transparent"
            app:titleEnabled="false"
            app:scrimVisibleHeightTrigger="100dp"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <FrameLayout
                android:id="@+id/frame_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/shape_background_main_header"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/panel_cover_art_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_collapseMode="parallax"
                android:background="@color/transparent">
                
                <RelativeLayout
                    android:id="@+id/cover_art_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constrainedHeight="true">
                    
                    <com.jackandphantom.carouselrecyclerview.view.ReflectionViewContainer
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:reflect_gap="0dp">

                        <apincer.android.mmate.ui.view.AspectRatioPhotoView
                            android:id="@+id/panel_cover_art"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scaleType="fitCenter"
                            app:heightRatio="1"
                            app:widthRatio="1"/>

                    </com.jackandphantom.carouselrecyclerview.view.ReflectionViewContainer>

                    <LinearLayout
                        android:id="@+id/title_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:background="@drawable/shape_background_main_header"
                        android:orientation="vertical"
                        android:paddingTop="42dp"
                        android:paddingBottom="16dp">

                        <TextView
                            android:id="@+id/panel_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Song Title"
                            android:maxLines="2"
                            android:lines="2"
                            android:gravity="center"
                            android:layout_gravity="top|center_horizontal"
                            android:fontFamily="@font/noto_sans_thai_bold"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:layout_marginStart="24dp"
                            android:layout_marginEnd="24dp" />
                    </LinearLayout>
                </RelativeLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="@dimen/dimen_32_dp"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <include layout="@layout/fragment_editor_preview" />
                
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:padding="8dp">

                    <apincer.android.mmate.ui.view.BadgeView
                        android:id="@+id/icon_codec"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <apincer.android.mmate.ui.view.QualityIndicatorView
                        android:id="@+id/icon_quality_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"/>

                    <apincer.android.mmate.ui.view.DynamicRangeView
                        android:id="@+id/dynamic_range_db_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"/>

                    <apincer.android.mmate.ui.view.RatingIndicatorView
                        android:id="@+id/rating_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        app:mode="mini"/>

                    <apincer.android.mmate.ui.view.NewIndicatorView
                        android:id="@+id/new_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
            </LinearLayout>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:tabIndicatorColor="#FFD700"
            app:tabSelectedTextColor="#FFD700"
            app:tabTextColor="#80FFFFFF"
            app:tabTextAppearance="@style/TextAppearance.Material3.TitleSmall"/>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewpager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="160dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>

    <!-- 🔹 Floating Action Capsule (True Bottom Anchor) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_navigation_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="4dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:strokeWidth="1dp"
        app:strokeColor="#33FFFFFF">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@drawable/shape_bottom_frosted_panel">

            <LinearLayout
                android:id="@+id/main_menu_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_delete"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delete"
                    android:textColor="#FF5252" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:layout_marginHorizontal="12dp"
                    android:background="#33FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_import"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Import"
                    app:cornerRadius="20dp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:layout_marginHorizontal="12dp"
                    android:background="#33FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_more"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="More..."
                    android:textColor="@color/white" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_edit"
                style="@style/Widget.Material3.Button"
                android:layout_below="@+id/main_menu_panel"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_centerInParent="true"
                android:layout_width="match_parent"
                android:layout_marginHorizontal="24dp"
                android:layout_height="wrap_content"
                android:text="Edit Song Info"
                app:cornerRadius="24dp" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_164_dp"
        android:background="@color/black_transparent_80"
        android:layout_gravity="bottom">
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>