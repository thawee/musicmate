            android:summary="Select high-performance HTTP web server engine for streaming"
            android:entries="@array/server_engine_entries"
            android:entryValues="@array/server_engine_values"
            android:defaultValue="httpcore"
            app:useSimpleSummaryProvider="true"/>
    </PreferenceCategory>
