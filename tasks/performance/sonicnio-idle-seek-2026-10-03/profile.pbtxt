buffers { size_kb: 65536 fill_policy: RING_BUFFER }
buffers { size_kb: 2048 fill_policy: RING_BUFFER }
duration_ms: 45000
data_sources { config {
 name: "linux.ftrace"
 ftrace_config {
  ftrace_events: "sched/sched_switch"
  ftrace_events: "sched/sched_waking"
  ftrace_events: "power/cpu_frequency"
  ftrace_events: "power/cpu_idle"
  atrace_categories: "dalvik"
  atrace_categories: "am"
  atrace_apps: "apincer.android.mmate"
  atrace_apps: "musicmate.db.room.test"
 }
} }
data_sources { config {
 name: "linux.process_stats"
 target_buffer: 1
 process_stats_config { scan_all_processes_on_start: true record_thread_names: true proc_stats_poll_ms: 100 }
} }
